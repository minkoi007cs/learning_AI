# ── Database (Supabase Postgres) ──────────────────────────────
# Runtime = POOLED connection (Transaction pooler, port 6543).
# Copy from Supabase → Project Settings → Database → Connection string → "Transaction".
# MUST append ?pgbouncer=true&connection_limit=1 for serverless.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations = DIRECT connection (port 5432). "Session" / direct string.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRATION="7d"

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"
OPENAI_FALLBACK_MODEL="gpt-4.1-mini"

# ── App ───────────────────────────────────────────────────────
API_PREFIX=v1
# Frontend origin(s) allowed by CORS, comma-separated. Set to your Vercel URL.
CORS_ORIGINS="http://localhost:3000"

# ── Rate limiting ─────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
