# ── Database (Supabase Postgres) ──────────────────────────────
# Runtime = kết nối POOLED (Transaction pooler, cổng 6543).
# Lấy ở Supabase → Project Settings → Database → Connection string → "Transaction".
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migration = kết nối TRỰC TIẾP (cổng 5432).
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET="doi-thanh-mot-chuoi-ngau-nhien-that-dai"
JWT_EXPIRATION="7d"

# ── AI ────────────────────────────────────────────────────────
# Sản phẩm nói "giao thức OpenAI", nên đổi nhà cung cấp = đổi 5 dòng dưới đây.
# Sau khi đổi, LUÔN chạy:  ./scripts/check-ai.sh
# (tên model của mọi nhà cung cấp đều thay đổi theo thời gian — đừng đoán)

# ▸ CÁCH A — Google Gemini (đám mây, có gói miễn phí). Dùng khi deploy Vercel.
#   Lấy khoá tại: https://aistudio.google.com/apikey
#   ⚠️ Gói thuê bao "Google AI Pro / Ultra" (mua trong app Gemini hoặc Google
#      One) KHÔNG cấp hạn mức cho API key — nó chỉ có tác dụng trong giao diện
#      web của Gemini và AI Studio. Khoá dưới đây chạy theo hạn mức MIỄN PHÍ của
#      API, hoặc theo giá trả-theo-lượt nếu bật thanh toán ở Google Cloud.
#      Xem hạn mức thật của tài khoản: https://aistudio.google.com/rate-limit
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
OPENAI_API_KEY=""                      # dán khoá Gemini vào đây
OPENAI_MODEL="gemini-2.5-flash"
OPENAI_FALLBACK_MODEL="gemini-2.5-flash-lite"
OPENAI_VISION_MODEL="gemini-2.5-flash" # Gemini đọc ảnh bằng chính model chat
OPENAI_EMBEDDING_MODEL="gemini-embedding-001"

# ▸ CÁCH B — Ollama chạy trên máy (miễn phí hoàn toàn). Dùng khi lập trình.
#   Bỏ dấu # ở 6 dòng dưới, và thêm # vào 6 dòng của CÁCH A.
#   Cài trước: ollama pull qwen3:8b && ollama pull qwen2.5vl:7b && ollama pull bge-m3
# OPENAI_BASE_URL="http://127.0.0.1:11434/v1"
# OPENAI_API_KEY="ollama"              # Ollama không kiểm tra, nhưng SDK bắt buộc có
# OPENAI_MODEL="qwen3:8b"
# OPENAI_FALLBACK_MODEL="qwen2.5:7b"
# OPENAI_VISION_MODEL="qwen2.5vl:7b"
# OPENAI_EMBEDDING_MODEL="bge-m3"

# ── Kho ảnh cho study guide (Supabase Storage) ────────────────
#   Hình rút từ slide (sơ đồ, bản vẽ, ảnh công trình) được lưu ở đây rồi
#   nhúng vào bài học. KHÔNG cấu hình cũng không sao: bài vẫn chạy, chỉ là
#   không có hình.
#
#   Chỉ cần DÁN ĐÚNG MỘT KHOÁ dưới đây — địa chỉ dự án được suy ra từ
#   DATABASE_URL, và kho ảnh (bucket) tự tạo ở lần chạy đầu.
#   Lấy khoá: Supabase → Project Settings → API → "service_role" (secret).
#   ⚠️ Khoá này qua mặt mọi quy tắc bảo mật của database — chỉ đặt ở máy chủ
#      (file .env hoặc biến môi trường Vercel), TUYỆT ĐỐI không đưa ra frontend.
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_URL="https://xxxx.supabase.co"   # chỉ cần khi suy ra tự động sai
# SUPABASE_STORAGE_BUCKET="slide-figures"   # mặc định đã là slide-figures

# ── Speech-to-text ────────────────────────────────────────────
# Ollama KHÔNG xử lý audio. Chạy faster-whisper ở tiến trình riêng, ví dụ:
#   docker run -p 9000:8000 fedirz/faster-whisper-server:latest-cpu
WHISPER_URL="http://127.0.0.1:9000"
WHISPER_MODEL="Systran/faster-whisper-medium"
# 'auto' = tự nhận diện ngôn ngữ. ĐỪNG đặt cứng 'en' — giảng viên có thể nói
# tiếng Việt, hoặc trộn Việt–Anh (BUG-03).
WHISPER_LANGUAGE="auto"

# ── App ───────────────────────────────────────────────────────
API_PREFIX=v1
PORT=3001
# Danh sách tên miền frontend được phép gọi API, cách nhau bằng dấu phẩy.
# Hỗ trợ ký tự đại diện: https://*.vercel.app
CORS_ORIGINS="http://localhost:3000"

# ── Giới hạn tần suất ─────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Số lượt gọi AI tối đa mỗi người mỗi ngày (chống lạm dụng — BUG-04)
AI_DAILY_LIMIT_PER_USER=60
