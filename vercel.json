{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build --workspace=@learning-ai/api && npm run build --workspace=@learning-ai/web",
  "outputDirectory": "apps/web/.next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "functions": {
    "apps/api/api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "apps/api/node_modules/pdfjs-dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/apps/api/api/index" }
  ]
}
